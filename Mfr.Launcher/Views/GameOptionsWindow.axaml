<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:Mfr.Launcher"
    xmlns:vm="clr-namespace:Mfr.Launcher.ViewModels"
    x:Class="Mfr.Launcher.Views.GameOptionsWindow"
    x:DataType="vm:GameOptionsViewModel"
    Title="Настройка сборки M[FR]"
    Width="838" Height="600"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    Background="Transparent"
    TextElement.Foreground="White">

    <Border BorderBrush="#8A6B3D" BorderThickness="2" CornerRadius="8" Background="#FF140B05">
        <Grid Margin="4,2,4,2" RowDefinitions="Auto,Auto,*,Auto">

            <Grid Grid.Row="0" Height="41" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{s:SkinImage headers/red_left.png}" Stretch="None" />
                <Image Grid.Column="1" Source="{s:SkinImage headers/red_center.png}" Stretch="Fill" MinWidth="320" />
                <Image Grid.Column="2" Source="{s:SkinImage headers/red_right.png}" Stretch="None" />
                <TextBlock Grid.Column="1" Text="Настройка сборки M[FR]" Classes="red" FontSize="21"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- контент: непрозрачная тёмная панель с рамкой, как в джава-версии -->
            <Border Grid.Row="2" Background="#E60D0703" BorderBrush="#8A6B3D" BorderThickness="1"
                    CornerRadius="4" Padding="14">
                <Grid ColumnDefinitions="320,*">
                    <ScrollViewer Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Пакеты опций" Classes="red" FontSize="17" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SectionRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                            <RadioButton Grid.Column="0" Content="{Binding Name}" MinWidth="140"
                                                         FontSize="17"
                                                         VerticalAlignment="Center"
                                                         IsChecked="{Binding IsSectionSelected, Mode=TwoWay}" />
                                            <s:SkinButton Grid.Column="1"
                                                    Classes.download="{Binding !Downloaded}"
                                                    Classes.remove="{Binding Downloaded}"
                                                    Command="{Binding ToggleCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Дополнительный контент" Classes="red" FontSize="17" Margin="0,14,0,8" />
                            <ItemsControl ItemsSource="{Binding Extras}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ExtraRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15"
                                                       Foreground="#D6C6AC" VerticalAlignment="Center" />
                                            <s:SkinButton Grid.Column="1"
                                                    Classes.download="{Binding !Downloaded}"
                                                    Classes.remove="{Binding Downloaded}"
                                                    Command="{Binding ToggleCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="1" Margin="14,0,18,0" RowDefinitions="Auto,Auto,Auto,*">
                        <TextBlock Grid.Row="0" Text="{Binding SelectedSection.Name}" Classes="red" FontSize="17"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <!-- варианты — горизонтальной строкой; слайдер появляется,
                             когда строка не помещается в ширину панели -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:OptionRowViewModel">
                                        <RadioButton Content="{Binding Name}" MinWidth="140"
                                                     IsChecked="{Binding IsSelectedByUser, Mode=TwoWay}"
                                                     Command="{Binding SelectCommand}" Margin="0,3,14,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Text="{Binding SelectedOptionDescription}" TextWrapping="Wrap"
                                   FontSize="14" Foreground="#B5A36A" Margin="0,0,0,4" />
                        <!-- превью — вся нижняя часть правой панели, без деления на колонки -->
                        <Image Grid.Row="3" Source="{Binding SelectedOptionImage}" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,8" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,4" ColumnDefinitions="*,Auto">
                <!-- прогресс или «Применить» — по центру; «Закрыть» — всегда справа:
                     длинная загрузка пакета не запирает игрока в окне -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center"
                            VerticalAlignment="Center" IsVisible="{Binding IsBusy}">
                    <TextBlock Text="{Binding ProgressDescription}" Classes="red" VerticalAlignment="Center" />
                    <ProgressBar Value="{Binding Percent}" Maximum="100" Width="220" Height="14"
                                 VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center"
                            VerticalAlignment="Center" IsVisible="{Binding !IsBusy}">
                    <s:SkinButton Classes="button154" Content="Применить" Command="{Binding ApplyCommand}"
                                  IsEnabled="{Binding ApplyButtonEnabled}" />
                </StackPanel>
                <s:SkinButton Grid.Column="1" Classes="button154" Content="Закрыть" Click="OnClose" />
            </Grid>
        </Grid>
    </Border>
</Window>
