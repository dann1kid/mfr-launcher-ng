# Образ заданий конвейера: SDK и прогретый кеш пакетов.
# Пересборка и публикация — ручное задание image:ci (см. .gitlab-ci.yml).
FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /src
COPY nuget.config global.json Directory.Build.props Directory.Packages.props ./
COPY Mfr.Protocol/*.csproj Mfr.Protocol/
COPY Mfr.Core/*.csproj Mfr.Core/
COPY Mfr.Launcher/*.csproj Mfr.Launcher/
COPY Mfr.Protocol.Tests/*.csproj Mfr.Protocol.Tests/
COPY Mfr.Smoke/*.csproj Mfr.Smoke/
COPY */packages.lock.json ./
RUN find . -name 'packages.lock.json' -exec bash -c 'mv "$1" "$(dirname "$1" | sed s/\.csproj//)" 2>/dev/null || true' _ {} \; \
    && dotnet restore Mfr.Launcher.slnx 2>&1 || true

# proto-генерация требует Grpc.Tools на первом restore — прогреваем и его
COPY Mfr.Protocol/Proto Mfr.Protocol/Proto
RUN dotnet restore Mfr.Protocol --force 2>&1 || true \
    && dotnet build Mfr.Protocol -c Release --no-restore 2>&1 | tail -1 || true

WORKDIR /
