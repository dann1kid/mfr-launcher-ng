<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mfr.Protocol\Mfr.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Файл адресов уезжает в сборку целиком, контур выбирает сборка: -p:MfrContour=test. -->
  <PropertyGroup>
    <MfrContour Condition="'$(MfrContour)' == ''">production</MfrContour>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\addresses.json" LogicalName="addresses.json" />
    <AssemblyMetadata Include="MfrContour" Value="$(MfrContour)" />
  </ItemGroup>
</Project>
